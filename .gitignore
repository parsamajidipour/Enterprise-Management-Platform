# ── Environment files (repo-wide) ─────────────────────────────────
# Covers the repo root, frontend/, and any other directory — not just
# backend/ — since Nuxt and Docker Compose both read .env from other
# locations too.
.env
.env.*
!.env.example
!.env.docker.example
!**/.env.example
!**/.env.docker.example

# ── Backend ──────────────────────────────────────────────────────
backend/vendor/
backend/storage/logs/*.log
backend/public/storage

# ── Frontend ─────────────────────────────────────────────────────
frontend/node_modules/
frontend/.nuxt/
frontend/.nuxt-build/
frontend/.output/

# ── Flutter / Mobile ─────────────────────────────────────────────
mobile/build/
mobile/.dart_tool/
mobile/.pub-cache/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/.gradle/
mobile/android/local.properties

# Flutter binary outputs
*.apk
*.aab
*.exe
*.iml

# ── Docker / Data ─────────────────────────────────────────────────
mysql_data/
backups/

# ── OS / Editor ───────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# ── Logs ──────────────────────────────────────────────────────────
*.log
